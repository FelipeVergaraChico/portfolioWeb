{
  "name": "felipe-vergara-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md docs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.9",
    "i18next": "^25.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
